default_platform(:ios)

platform :ios do
  desc "Resolve and run tests"
  lane :run_tests do
    run_tests(
      scheme: "CiCdProjekt",
      test_plan: "CiCdProject.xctestplan",
      devices: ["iPhone 14"]
    )
  end

  desc "Build dev"
  lane :dev_build do
    build_app(
      scheme: "CiCdProjekt",
      export_method: "development"
    )
  end

  desc "Setup CI Certificates"
  lane :setup_ci do
    match(
      type: "development",
      readonly: true
    )
  end
end